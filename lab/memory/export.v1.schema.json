{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory and learning public export v1 (PROPOSED by Agent 2; pending Agent 1 acceptance)",
  "description": "Build-time, sanitized envelope consumed by site/memory.html. Generated by site/memory_export.py from the public journals of contract v1. Contains only public records, aggregates and safe links.",
  "type": "object",
  "required": ["export_version", "demo", "generated_at", "data_status", "last_success_at"],
  "properties": {
    "export_version": {"const": "1.0.0"},
    "demo": {"type": "boolean", "description": "true only for the DEMO fixture; the production build refuses true."},
    "generated_at": {"type": "string"},
    "source_commit": {"type": ["string", "null"]},
    "data_status": {"enum": ["available", "stale", "empty", "unavailable"]},
    "last_success_at": {"type": ["string", "null"]},
    "contract_version": {"type": "string"},
    "rule_version": {"type": "string"},
    "mode": {"enum": ["SHADOW", "CANARY", "COUPLED", "ROLLED_BACK", "UNKNOWN"]},
    "memory_enabled": {"type": ["boolean", "null"]},
    "coupling_scope": {"type": ["string", "null"]},
    "reward_influence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "mode_history": {"type": "array", "items": {"type": "object", "required": ["at", "to", "influence", "reason"],
      "properties": {"at": {}, "from": {}, "to": {}, "influence": {}, "scope": {}, "rule_version": {}, "decided_by": {"type": "array"}, "reason": {"type": "string"}, "evidence_refs": {"type": "array"}}}},
    "agents": {"type": "object", "additionalProperties": {"type": "object",
      "required": ["positive", "negative", "net", "graded", "pending", "disputed", "cost"],
      "properties": {"positive": {"type": "number", "minimum": 0}, "negative": {"type": "number", "maximum": 0}, "net": {"type": "number"},
        "graded": {"type": "integer"}, "pending": {"type": "integer"}, "disputed": {"type": "integer"}, "duplicates": {"type": "integer"}, "capped": {"type": "integer"},
        "cost": {"type": "object", "required": ["value", "unit", "measured"]}}}},
    "events": {"type": "array", "items": {"type": "object", "required": ["id", "agent", "task", "category", "status", "value", "rule_version", "reason", "occurred_at", "refs", "history"]}},
    "memories": {"type": "object", "required": ["public", "private"], "properties": {"private": {"type": "object", "required": ["available"]}}},
    "shadow": {"type": "object"},
    "readiness": {"type": "object", "required": ["criteria", "assessments"]},
    "map_links": {"type": "array"}
  }
}
