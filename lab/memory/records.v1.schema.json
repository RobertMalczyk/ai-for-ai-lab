        "decision_id",
        "agent",
        "task_id",
        "task_type",
        "session_id",
        "occurred_at",
        "rule_version",
        "memory_ids",
        "suggested_action",
        "actual_action",
        "shadow_memory_ids",
        "alternative_outcome",
        "evaluation_ref",
        "cost",
        "map_node_ids"
      ]
    },
    "utility": {
