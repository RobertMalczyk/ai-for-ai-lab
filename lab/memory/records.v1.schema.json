{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI LAB public memory interchange v1.0.0",
  "$defs": {
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "measured": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "unit",
        "measured"
      ]
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "experience",
            "lesson",
            "procedure"
          ]
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "public"
          ]
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "available_at": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_status": {
          "enum": [
            "unverified",
            "verified",
            "reviewed"
          ]
        },
        "source_outcome": {
          "enum": [
            "positive",
            "negative",
            "inconclusive",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "active",
            "provisional",
            "superseded",
            "retracted"
          ]
        },
        "historical_seed": {
          "type": "boolean"
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        },
        "correction_effective_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "map_node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "applicability_conditions": {
          "type": "string",
          "minLength": 1
        },
        "falsifier": {
          "type": "string",
          "minLength": 1
        },
        "promoted_at": {
          "type": "string",
          "minLength": 1
        },
        "promoted_by": {
          "enum": [
            "agent1",
            "agent2"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "author",
        "visibility",
        "created_at",
        "available_at",
        "source_refs",
        "scope",
        "content",
        "exceptions",
        "confidence",
        "evidence_status",
        "source_outcome",
        "status",
        "historical_seed",
        "supersedes",
        "correction_effective_at",
        "map_node_ids"
      ]
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_key": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "enum": [
            "agent1",
            "agent2"
          ]
        },
        "proposer": {
          "type": "string",
          "minLength": 1
        },
        "verifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "proposed",
            "verified",
            "disputed",
            "retracted",
            "pending"
          ]
        },
        "category": {
          "enum": [
            "useful_result",
            "review_correction",
            "new_finding",
            "activity",
            "repeated_error",
            "constraint_violation",
            "unresolved"
          ]
        },
        "value": {
          "enum": [
            -1,
            -0.5,
            0,
            0.2,
            0.5,
            1,
            null
          ]
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "occurred_at": {
          "type": "string",
          "minLength": 1
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "memory_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "event_id",
        "task_id",
        "evidence_key",
        "agent",
        "proposer",
        "verifier",
        "status",
        "category",
        "value",
        "rule_version",
        "rationale",
        "source_refs",
        "occurred_at",
        "verified_at",
        "memory_ids",
        "session_id",
        "supersedes"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "useful_result"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "review_correction"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "const": 0.5
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "new_finding"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "const": 0.2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "activity"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "repeated_error"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "const": -0.5
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "constraint_violation"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "const": -1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "unresolved"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1
