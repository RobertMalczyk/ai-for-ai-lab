        },
        "evaluation_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "map_node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
