{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared agent artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "author",
    "kind",
    "summary",
    "evidence_ref"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "author": {
      "enum": [
        "chatgpt",
        "opus"
      ]
    },
    "kind": {
      "enum": [
        "request",
        "artifact",
        "evaluation",
        "adoption"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "^https://github\\.com/RobertMalczyk/ai-for-ai-lab/(commit|pull|issues|blob)/[^\\s]+$"
    },
    "result": {
      "type": "string",
      "maxLength": 4000
    }
  }
}
